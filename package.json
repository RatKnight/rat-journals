{
  "name": "rat-journal",
  "version": "26.0.6",
  "description": "A modern, encrypted, local-first desktop journaling application",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "tauri": "bun scripts/tauri-dev.js",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:scripts": "node scripts/run-script-tests.mjs",
    "pre-commit": "node scripts/pre-commit.js",
    "hooks:install": "node scripts/install-hooks.js",
    "check": "node scripts/quick-check.js",
    "test:e2e": "node scripts/run-e2e.js clean",
    "test:e2e:stateful": "node scripts/run-e2e.js stateful",
    "test:e2e:local": "node scripts/e2e-local.js",
    "validate:locales": "npx tsx scripts/validate-locales.ts",
    "bench": "vitest bench",
    "check:ui-errors": "node scripts/check-ui-error-sanitization.js",
    "check:build-paths": "node scripts/check-stale-build-paths.js",
    "check:test-runners": "node scripts/check-test-runners.mjs",
    "test:print": "playwright test --config playwright.config.ts",
    "postinstall": "node scripts/install-hooks.js"
  },
  "license": "MIT",
  "puppeteer": {
    "skipDownload": true
  },
  "overrides": {
    "serialize-javascript": "7.0.5",
    "uuid": "^11.1.1",
    "basic-ftp": "^5.3.1",
    "mermaid": "11.16.1",
    "katex": "^0.19.0",
    "fast-xml-parser": "^5.10.1",
    "ip-address": "^10.5.0",
    "prosemirror-model": "^1.25.11",
    "source-map-js": "^1.2.2"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.14",
    "@solid-primitives/i18n": "^2.2.1",
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-opener": "~2.7.0",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-color": "^3.31.4",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-text-style": "3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "browserslist": "^4.29.1",
    "dompurify": "^3.4.16",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-solid": "^1.53.0",
    "marked": "^18.1.0",
    "pdfjs-dist": "^6.4.299",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@solidjs/testing-library": "^0.8.10",
    "@tauri-apps/cli": "^2.11.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@unocss/reset": "^66.10.5",
    "@unocss/vite": "^66.10.5",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/ui": "^5.0.2",
    "@wdio/cli": "^10.0.0",
    "@wdio/local-runner": "^10.0.0",
    "@wdio/mocha-framework": "^10.0.0",
    "@wdio/spec-reporter": "^10.0.0",
    "@wdio/types": "^10.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-solid": "^0.18.1",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "unocss": "^66.10.5",
    "vite": "^8.3.3",
    "vite-plugin-solid": "^2.11.13",
    "vitest": "^5.0.0",
    "webdriverio": "^10.0.0",
    "@playwright/test": "^1.64.0"
  }
}
